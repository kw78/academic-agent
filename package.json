{
  "name": "academic-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Academic Agent — event-sourced personal academic assistant following the Academic Agent architecture baseline.",
  "repository": {
    "type": "git",
    "url": "https://github.com/kw78/academic-agent.git"
  },
  "homepage": "https://github.com/kw78/academic-agent#readme",
  "packageManager": "npm@10.9.8",
  "workspaces": [
    "packages/*",
    "adapters/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "tsx apps/academic-cli/src/main.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "build:dsh": "node packages/academic-dsh-plugin/build.mjs",
    "build:ui": "node packages/academic-dsh-ui/build.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "^0.28.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
