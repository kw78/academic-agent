{
  "name": "classhelper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Event-sourced personal academic assistant following the Academic Agent architecture baseline.",
  "packageManager": "npm@10.9.8",
  "workspaces": [
    "packages/*",
    "adapters/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "tsx apps/academic-cli/src/main.ts"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
