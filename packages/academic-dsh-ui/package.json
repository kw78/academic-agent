{
  "name": "@academic/dsh-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Academic Agent DSH client UI: panel, navigation entry and Host Remote API adapter.",
  "main": "lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.1 <0.3.0-0"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-typert-protocol": {
      "optional": true
    }
  },
  "dependencies": {
    "@academic/contracts": "0.1.0",
    "@academic/notifications": "0.1.0",
    "@academic/planner-basic": "0.1.0",
    "@academic/scheduler": "0.1.0",
    "zod": "4.6.7",
    "playwright-core": "1.64.1"
  },
  "devDependencies": {
    "@academic/cli": "0.1.0",
    "@deepseek-ai/cordis": "4.0.5",
    "@types/react": "18.3.12",
    "react": "18.3.1"
  },
  "scripts": {
    "build": "node build.mjs"
  }
}
