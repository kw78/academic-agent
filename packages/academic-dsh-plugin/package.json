{
  "name": "@academic/dsh-plugin",
  "version": "0.1.0",
  "type": "module",
  "description": "DSH bundle exposing Academic Agent query and task tools to the model.",
  "main": "lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./host": "./lib/host.js",
    "./tools": "./lib/tools.js",
    "./planner": "./lib/planner.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "migrations",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.1 <0.3.0-0"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5"
  },
  "scripts": {
    "build": "node build.mjs"
  },
  "dependencies": {
    "playwright-core": "1.64.1"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kw78/academic-agent.git",
    "directory": "packages/academic-dsh-plugin"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0"
}
