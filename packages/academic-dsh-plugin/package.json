{
  "name": "@academic/dsh-plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DSH bundle exposing Academic Agent query and task tools to the model.",
  "main": "lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./host": "./lib/host.js",
    "./tools": "./lib/tools.js",
    "./planner": "./lib/planner.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "migrations",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.1 <0.3.0-0"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "devDependencies": {
    "@academic/agent-tools": "0.1.0",
    "@academic/cli": "0.1.0",
    "@deepseek-ai/cordis": "4.0.5"
  },
  "scripts": {
    "build": "node build.mjs"
  },
  "dependencies": {
    "@academic/sources": "0.1.0",
    "@academic/source-browser": "0.1.0",
    "playwright-core": "1.64.1"
  }
}
